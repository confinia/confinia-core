# E2E subscribe-and-pay harness (issue #208). Copy to tests/e2e/.env
# (GITIGNORED) and fill in. An unset variable stops the run; nothing guesses.

# Which environment the server-side verdict is checked against: test | live.
# The harness only ever runs against Creem TEST; live is refused here.
CREEM_ENV=test

# Creem test API: creates the checkout session and reads back the subscription.
# A creem_test_ key -- never the live one; the runner refuses a live prefix.
CREEM_API_KEY=creem_test_...

# The tier product to subscribe to (any of the ladder's product ids).
CREEM_PRODUCT=prod_...

# The disposable email the journey subscribes as. The verdict looks it up.
E2E_EMAIL=e2e-run@confinia.io

# The provider's public test card (documented; not a secret).
TEST_CARD=4111111111111111
