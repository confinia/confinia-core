# Confinia SANDBOX edge -- its OWN caddy process, not a second listen address
# on the production one (platform RULES.md §6).
#
# Until 2026-08-16 sandbox.confinia.io was served by confinia_caddy_1, the same
# process as www and api. A config error, crash or leak while working on the
# sandbox took production with it -- and the sandbox is by definition where
# unfinished things are tried. A different port on the same process would have
# satisfied the numbering and none of the isolation.
#
# Runs from deploy/sandbox-stack/docker-compose.yml, its own compose project, so
# it can be restarted and broken without touching confinia_caddy_1.
# Reload: ./deploy/deploy-edge-sandbox.sh
{
	auto_https off
	# VM RULE: every host-network caddy MUST have a UNIQUE admin address --
	# sharing localhost:2019 lets a `caddy reload` load its config into ANOTHER
	# caddy's process (VM-wide outage of 2026-07-20). The production edge holds
	# 2085; this one takes its own inside our band: 1(confinia) 4(sandbox)
	# 9(admin) 0.
	admin localhost:11490
	servers {
		trusted_proxies static private_ranges
	}
}

# (staging_auth) comes from ~/confinia-edge-state, generated by
# deploy/stacks.sh; the same credentials guard staging and sandbox.
import /etc/caddy/active/*.caddy

(block_scanners) {
	# A named matcher can only be defined ONCE: one matcher per group.
	# dotfiles & repositories (at the root and at any depth)
	@scan_dotfiles path /.env /.env* */.env* /.git /.git* */.git/* /.aws /.aws* */.aws/* /.svn* /.hg* /.ssh* /.npmrc /.dockercfg /.docker* /.DS_Store /.vscode* /.idea* /.bash_history //*
	abort @scan_dotfiles
	# PHP / WordPress / e-commerce
	@scan_php path *.php *.php* /stripe /stripe/* /wp-admin* /wp-login* /wp-content* /wp-includes* /xmlrpc.php /vendor/*
	abort @scan_php
	# secrets files & configs (unambiguous names, at any depth)
	@scan_secrets path */terraform.tf* */serviceAccountKey.json */service_account.json */service-account.json */firebase-adminsdk.json */firebase.json */gcp-credentials.json */aws-exports.js */awsconfiguration.json */amplifyconfiguration.json */secrets.json */keys.json */key.json */token.json */env.json */env.js */local_settings.py */instance/config.py */application.properties */application.yml /aws-ses.json /aws-config.js /credentials* /config.json*
	abort @scan_secrets
	# infra configs (root only: too generic at depth)
	@scan_infra path /settings.json /web.config /vercel.json /netlify.toml /serverless.yml /docker-compose.yml /config.yml /config.js /graphql /debug/vars /sellers.json /app-ads.txt /ads.txt
	abort @scan_infra
	# phishing kits (probes for signature js/css files)
	@scan_phishkit path /bot-connect.js /js/twint_ch.js /js/lkk_ch.js /js/antibot-client.js /css/support_parent.css /static/style/* /assets/js/auth.js /assets/js/message.js /assets/js/qr_modal.js
	abort @scan_phishkit
}

http://sandbox.confinia.io:11400 {
	# Loopback only (platform audit, overwatch #35). The platform edge reaches
	# us on 127.0.0.1, so routing is unchanged -- but binding every interface
	# made ufw the single rule between staging/sandbox and the internet, the
	# same shape as the ops-db finding. Worse here: the basic_auth gate lives in
	# THIS process, so anyone reaching it directly would send credentials over
	# plaintext HTTP, around the edge's TLS.
	#
	# The otel collector must NOT get this treatment: the stack APIs push through
	# host.containers.internal, the podman gateway, which is not the host
	# loopback. A loopback bind there makes it unreachable from every container
	# at once -- and an exporter with nowhere to send does not error, it stops
	# reporting.
	bind 127.0.0.1
	encode zstd gzip
	# Polar sandbox webhook: PUBLIC (signature-verified) — Polar can't send
	# basic auth. Must stay outside the auth guard below.
	handle /polar/webhook {
		# sandbox API moved 8089 -> 11420 (1PESI direct swap; stack was down)
		reverse_proxy 127.0.0.1:11420
	}
	# Everything else is behind basic auth (same credentials as staging).
	handle {
		import staging_auth
		# Keycloak on the sandbox host (confinia-sbx realm): the whole auth
		# flow stays on sandbox.confinia.io.
		handle /auth/* {
			reverse_proxy 127.0.0.1:11070
		}
		handle_path /api/* {
			route {
				import block_scanners
				reverse_proxy 127.0.0.1:11420
			}
		}
		handle /account.html {
			root * /srv/sbx-site/sbx
			file_server
		}
		handle /commune/* {
			root * /srv/sbx-site
			rewrite * /commune.html
			file_server
		}
		handle /pricing {
			root * /srv/sbx-site/sbx
			rewrite * /pricing.html
			file_server
		}
		handle /polar-embed.js {
			root * /srv/sbx-site/sbx
			file_server
		}
		handle {
			root * /srv/sbx-demo
			file_server
		}
	}
}
