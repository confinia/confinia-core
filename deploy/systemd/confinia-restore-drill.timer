[Unit]
Description=Confinia weekly restore drill
[Timer]
# Sunday 05:12 UTC -- an hour after the nightly dump, so it exercises a FRESH
# one rather than yesterday's. Weekly, not nightly: the drill restores a full
# cluster, and a check that costs more than the thing it guards gets disabled.
OnCalendar=Sun *-*-* 05:12:00
Persistent=true
[Install]
WantedBy=timers.target
