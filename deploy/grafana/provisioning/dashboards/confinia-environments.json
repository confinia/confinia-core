{
  "uid": "confinia-environments",
  "title": "Confinia Environments",
  "schemaVersion": 39,
  "refresh": "30s",
  "timezone": "utc",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "BLUE color — role",
      "description": "Which role the blue stack plays right now (from the active-* marker written by stacks.sh promote).",
      "gridPos": { "x": 0, "y": 0, "w": 5, "h": 5 },
      "targets": [
        { "expr": "count(file_mtime_seconds{file_name=\"active-blue\"}) OR on() vector(0)", "legendFormat": "blue" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "1": { "text": "PROD", "color": "blue", "index": 0 },
              "0": { "text": "STAGING", "color": "#4a5568", "index": 1 }
            } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#4a5568", "value": null } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "GREEN color — role",
      "description": "Which role the green stack plays right now (from the active-* marker written by stacks.sh promote).",
      "gridPos": { "x": 5, "y": 0, "w": 5, "h": 5 },
      "targets": [
        { "expr": "count(file_mtime_seconds{file_name=\"active-green\"}) OR on() vector(0)", "legendFormat": "green" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "1": { "text": "PROD", "color": "green", "index": 0 },
              "0": { "text": "STAGING", "color": "#4a5568", "index": 1 }
            } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#4a5568", "value": null } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Last promotion",
      "description": "Age of the last blue/green switchover (mtime of the active-* marker).",
      "gridPos": { "x": 10, "y": 0, "w": 5, "h": 5 },
      "targets": [
        { "expr": "time() - max(file_mtime_seconds{file_name=~\"active-.*\"})", "legendFormat": "age" }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Public edge → ACTIVE",
      "description": "https://api.confinia.io/healthz through the full public chain (platform caddy → app caddy → active color).",
      "gridPos": { "x": 15, "y": 0, "w": 9, "h": 5 },
      "targets": [
        { "expr": "max(httpcheck_status{http_url=\"https://api.confinia.io/healthz\",http_status_class=\"2xx\"})", "legendFormat": "edge" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "1": { "text": "UP", "color": "green", "index": 0 },
              "0": { "text": "DOWN", "color": "red", "index": 1 }
            } },
            { "type": "special", "options": { "match": "null", "result": { "text": "NO PROBE", "color": "red", "index": 2 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Blue API (:11120)",
      "gridPos": { "x": 0, "y": 5, "w": 6, "h": 4 },
      "targets": [
        { "expr": "max(httpcheck_status{http_url=\"http://127.0.0.1:11120/healthz\",http_status_class=\"2xx\"})", "legendFormat": "blue" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "1": { "text": "UP", "color": "green", "index": 0 },
              "0": { "text": "DOWN", "color": "red", "index": 1 }
            } },
            { "type": "special", "options": { "match": "null", "result": { "text": "NO PROBE", "color": "red", "index": 2 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Green API (:11220)",
      "gridPos": { "x": 6, "y": 5, "w": 6, "h": 4 },
      "targets": [
        { "expr": "max(httpcheck_status{http_url=\"http://127.0.0.1:11220/healthz\",http_status_class=\"2xx\"})", "legendFormat": "green" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "1": { "text": "UP", "color": "green", "index": 0 },
              "0": { "text": "DOWN", "color": "red", "index": 1 }
            } },
            { "type": "special", "options": { "match": "null", "result": { "text": "NO PROBE", "color": "red", "index": 2 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Sandbox API (:11420)",
      "gridPos": { "x": 12, "y": 5, "w": 6, "h": 4 },
      "targets": [
        { "expr": "max(httpcheck_status{http_url=\"http://127.0.0.1:11420/healthz\",http_status_class=\"2xx\"})", "legendFormat": "sandbox" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "1": { "text": "UP", "color": "green", "index": 0 },
              "0": { "text": "DOWN", "color": "red", "index": 1 }
            } },
            { "type": "special", "options": { "match": "null", "result": { "text": "NO PROBE", "color": "red", "index": 2 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Keycloak (:11070)",
      "gridPos": { "x": 18, "y": 5, "w": 6, "h": 4 },
      "targets": [
        { "expr": "max(httpcheck_status{http_url=\"http://127.0.0.1:11070/auth/realms/confinia\",http_status_class=\"2xx\"})", "legendFormat": "keycloak" }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": {
              "1": { "text": "UP", "color": "green", "index": 0 },
              "0": { "text": "DOWN", "color": "red", "index": 1 }
            } },
            { "type": "special", "options": { "match": "null", "result": { "text": "NO PROBE", "color": "red", "index": 2 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null } ] }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Liveness history (1 = up)",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 9 },
      "targets": [
        { "expr": "max(httpcheck_status{http_url=\"http://127.0.0.1:11120/healthz\",http_status_class=\"2xx\"})", "legendFormat": "blue" },
        { "expr": "max(httpcheck_status{http_url=\"http://127.0.0.1:11220/healthz\",http_status_class=\"2xx\"})", "legendFormat": "green" },
        { "expr": "max(httpcheck_status{http_url=\"http://127.0.0.1:11420/healthz\",http_status_class=\"2xx\"})", "legendFormat": "sandbox" },
        { "expr": "max(httpcheck_status{http_url=\"http://127.0.0.1:11070/auth/realms/confinia\",http_status_class=\"2xx\"})", "legendFormat": "keycloak" },
        { "expr": "max(httpcheck_status{http_url=\"https://api.confinia.io/healthz\",http_status_class=\"2xx\"})", "legendFormat": "public edge" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1.05,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 8 }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Probe latency",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 9 },
      "targets": [
        { "expr": "max(httpcheck_duration_milliseconds{http_url=\"http://127.0.0.1:11120/healthz\"})", "legendFormat": "blue" },
        { "expr": "max(httpcheck_duration_milliseconds{http_url=\"http://127.0.0.1:11220/healthz\"})", "legendFormat": "green" },
        { "expr": "max(httpcheck_duration_milliseconds{http_url=\"http://127.0.0.1:11420/healthz\"})", "legendFormat": "sandbox" },
        { "expr": "max(httpcheck_duration_milliseconds{http_url=\"http://127.0.0.1:11070/auth/realms/confinia\"})", "legendFormat": "keycloak" },
        { "expr": "max(httpcheck_duration_milliseconds{http_url=\"https://api.confinia.io/healthz\"})", "legendFormat": "public edge" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 8 }
        },
        "overrides": []
      }
    }
  ]
}
