# SMTP for alert@confinia.io — copy to deploy/mail.env on the VM, chmod 600.
# deploy/mail.env is GITIGNORED and must never be committed (issue #132).
#
# OVH hosts the domain's mail and SPF is "v=spf1 include:mx.ovh.com -all", a
# hard fail — so sending through any third party would be rejected until that
# DNS record changes. OVH SMTP is not merely the cheap option, it is the one the
# DNS already permits.
#
# ONE password, ONCE. The first version of this file asked for the same secret
# under two names (SMTP_PASSWORD and GF_SMTP_PASSWORD); exactly one of them got
# filled in, which is what a duplicated secret always produces. The GF_ prefix
# is simply what Grafana requires, and everything else reads the same variables.

GF_SMTP_ENABLED=true
GF_SMTP_HOST=ssl0.ovh.net:587
GF_SMTP_USER=alert@confinia.io
GF_SMTP_PASSWORD=CHANGE_ME
GF_SMTP_FROM_ADDRESS=alert@confinia.io
GF_SMTP_FROM_NAME=Confinia
GF_SMTP_STARTTLS_POLICY=OpportunisticStartTLS

# Where ops alerts land. Not a secret; also written literally in the provisioned
# contact point, because Grafana does not expand variables in provisioning files.
ALERT_TO=contact@confinia.io
