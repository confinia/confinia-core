# SMTP for alert@confinia.io — copy to deploy/mail.env on the VM, chmod 600.
# deploy/mail.env is GITIGNORED and must never be committed (issue #132).
#
# OVH hosts the domain's mail and SPF is "v=spf1 include:mx.ovh.com -all" — a
# hard fail. Sending through any third party would be rejected until that DNS
# record changes, so OVH SMTP is not just the cheap option, it is the one the
# DNS already permits.

SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=alert@confinia.io
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=alert@confinia.io
SMTP_FROM_NAME=Confinia
ALERT_TO=contact@confinia.io

# Grafana reads these directly; same values, its own names.
GF_SMTP_ENABLED=true
GF_SMTP_HOST=ssl0.ovh.net:587
GF_SMTP_USER=alert@confinia.io
GF_SMTP_PASSWORD=CHANGE_ME
GF_SMTP_FROM_ADDRESS=alert@confinia.io
GF_SMTP_FROM_NAME=Confinia
GF_SMTP_STARTTLS_POLICY=OpportunisticStartTLS
