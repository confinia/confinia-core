data/
*.geojson
*.gpkg
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.7z
*.zip
*.csv

# OS / editor
.DS_Store
.idea/
.vscode/

# Local env
.env
# Secrets (mot de passe admin Grafana…) — jamais dans le repo
deploy/secrets.env
# Polar sandbox credentials (test environment) — never in the repo
deploy/sandbox.env
# SMTP for alert@confinia.io — never in the repo (issue #132).
# deploy/mail.env.example is the committed template.
deploy/mail.env

# Captured HTTP archives may contain session cookies — never commit
*.har
api/VERSION

# Business-sensitive documents (2026-08-15, founder decision). Present on disk,
# never in git: they were purged from the whole history, and .gitignore is what
# stops them coming back on the next `git add -A`.
RULES.md
POLAR.md
SPECIFICATIONS.md
deploy/creem.env
.mcp.json

tests/e2e/.env

# --- Secrets by SHAPE, not by name -------------------------------------------
# Everything above names one file each. That is an allowlist by enumeration, and
# it fails the way allowlists do: on 2026-08-22 the VM's working copy held
# `mail.env` at the repo root and two `secrets.env.bak.*` from the DSN
# rotations, none of them ignored, each carrying live credentials. Any
# `git add -A` -- which is how most of this repo's commits are staged -- would
# have put them in a public repository.
#
# So: match the shape. The two committed templates are excepted explicitly, and
# a test asserts they stay excepted.
*.env
!*.env.example
*.bak
*.bak.*

**/*.key